{
  "project": "Masar - Smart Traffic Intelligence",
  "task": "Next-observation (~10 minute) congestion classification",
  "target": "congestion_level at time t",
  "target_definition": {
    "Low": "speed_ratio >= 0.85",
    "Medium": "0.60 <= speed_ratio < 0.85",
    "High": "speed_ratio < 0.60"
  },
  "leakage_rule": "No contemporaneous speed_ratio/current_speed/delay from target time is used. Dynamic features are lagged.",
  "split": "Chronological by unique timestamps: 72% train / 8% validation / 20% test",
  "selected_ml_model": "Random Forest",
  "selection_metric": "validation macro_f1",
  "pilot_only": true,
  "features": [
    "hour_sin",
    "hour_cos",
    "dow_sin",
    "dow_cos",
    "is_weekend",
    "speed_ratio_lag1",
    "speed_ratio_lag2",
    "speed_ratio_lag3",
    "delay_s_lag1",
    "delay_s_lag2",
    "delay_s_lag3",
    "current_speed_kmh_lag1",
    "current_speed_kmh_lag2",
    "current_speed_kmh_lag3",
    "current_travel_time_s_lag1",
    "free_flow_speed_kmh_lag1",
    "free_flow_travel_time_s_lag1",
    "confidence_lag1",
    "road_closure_lag1",
    "speed_ratio_roll3_mean",
    "speed_ratio_roll3_std",
    "delay_s_roll3_mean",
    "delay_s_roll3_std",
    "current_speed_kmh_roll3_mean",
    "current_speed_kmh_roll3_std",
    "road",
    "point_id",
    "frc",
    "congestion_prev"
  ],
  "continuous_history_rule": "Target and prior two intervals must each be <= 15 minutes.",
  "evaluated_model": "models/random_forest_evaluated_dev80.joblib (trained on train+validation; test kept untouched)",
  "demo_model": "models/random_forest_pilot_fullfit.joblib (fit on all eligible pilot rows after evaluation; not used for reported test score)"
}